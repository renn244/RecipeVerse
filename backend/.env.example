# Server
PORT=4000
# Public URL of this API (used to build image URLs saved in the database)
SERVER_URL=http://localhost:4000
# Frontend origin allowed by CORS
CLIENT_URL=http://localhost:3000

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/recipeverse?schema=public

# Auth
SESSION_SECRET=change-me-to-a-long-random-string
BCRYPT_SALTROUNDS=10

# Email for 2FA / OTP codes (Gmail account + app password)
GMAIL_USER=you@gmail.com
GMAIL_PASSWORD=your-gmail-app-password
